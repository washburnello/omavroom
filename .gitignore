# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtualenvs (uv recreates these from uv.lock + .python-version, both tracked)
.venv/

# pytest / ruff
.pytest_cache/
.ruff_cache/

# sqlite state (runtime artifacts, incl. WAL sidecars)
*.db
*.db-wal
*.db-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# omavroom local artifacts (Phase 1): VM disk images + installer ISOs live
# outside the repo (~/.local/share/omavroom, ~/.cache/omavroom); ignore any
# copies that land in the worktree. Screenshots default to
# ~/.local/share/omavroom/screenshots, but ignore stray ones defensively.
*.qcow2
*.iso
omavroom-*.png
